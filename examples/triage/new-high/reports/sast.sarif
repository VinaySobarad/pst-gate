{
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "semgrep",
          "rules": [{"id": "python.sql-injection"}]
        }
      },
      "results": [
        {
          "ruleId": "python.sql-injection",
          "level": "error",
          "message": {"text": "SQL injection"},
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {"uri": "app/db.py"},
                "region": {"startLine": 10}
              }
            }
          ],
          "properties": {
            "security-severity": "8.1"
          }
        }
      ]
    }
  ]
}
